  "group_size": 8,
  "eval_every": 2,
  "eval_size": 64,
  "eval_samples_per_prompt": 4,
  "max_tokens": 2048,
  "penalty_coef": 0.5,
  "kl_coef": 0.0001,
  "kl_discount_factor": 0.0,
  "lora_rank": 64,
  "lr": null,
  "seed": 1,
  "n_prompts_pool": 512,
  "monitors": [
    {
      "kind": "cot",
      "name": "cot_weak",
