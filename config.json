    {
      "kind": "cot",
      "name": "cot_strong",
      "role": "held_out",
      "model_id": "deepseek/deepseek-chat",
      "behavior": null,
      "threshold": 0.5,
      "use_cot": true
    },
    {
      "kind": "cot",
      "name": "out_weak",
      "role": "held_out",
      "model_id": "anthropic/claude-3-haiku",
      "behavior": null,
      "threshold": 0.5,
      "use_cot": false
    },
    {
      "kind": "cot",
      "name": "out_strong",
      "role": "held_out",
      "model_id": "deepseek/deepseek-chat",
      "behavior": null,
      "threshold": 0.5,
      "use_cot": false
    }
  ]
}
