{
  "run_name": "mbpp_inkling_small_cot_weak_s1_lowpen",
  "experiment": "mbpp_inklig",
  "description": "Train AGAINST cot_weak on MBPP-Honeypot (reward-hacking); hold out cot_strong, out_weak, out_strong, probe_ood, probe_iid. All scored on the fixed held-out eval set each eval_every (eval_metrics.jsonl).",
