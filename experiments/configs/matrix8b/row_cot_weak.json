{
  "experiment": "degradation_matrix_8b",
  "policy": "Qwen/Qwen3-8B",
  "backend": "tinker",
  "subset": "nlp",
  "n_steps": 40,
  "batch_size": 8,
  "group_size": 8,
  "eval_every": 10,
  "eval_size": 32,
  "max_tokens": 4096,
  "penalty_coef": 1.0,
  "run_name": "matrix8b_cot_weak",
  "description": "Degradation-matrix row: train AGAINST cot_weak, hold out the other 3 detectors (cot_strong, probe_ood, probe_iid). All 4 monitors are scored on the fixed held-out eval set every eval_every steps (eval_metrics.jsonl). Identical to the other rows except which detector is train_against.",
  "monitors": [
    {
      "kind": "cot",
      "name": "cot_weak",
      "role": "train_against",
      "model_id": "anthropic/claude-3.5-haiku"
    },
    {
      "kind": "cot",
      "name": "cot_strong",
      "role": "held_out",
      "model_id": "anthropic/claude-sonnet-4.6"
    },
    {
      "kind": "probe",
      "name": "probe_ood",
      "role": "held_out",
      "probe_path": "data/probes/Qwen3-8B/diverse_deception",
      "probe_model": "Qwen/Qwen3-8B"
    },
    {
      "kind": "probe",
      "name": "probe_iid",
      "role": "held_out",
      "probe_path": "data/probes/Qwen3-8B/sycophancy_cot",
      "probe_model": "Qwen/Qwen3-8B"
    }
  ]
}
