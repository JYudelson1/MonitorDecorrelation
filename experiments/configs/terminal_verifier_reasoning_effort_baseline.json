{
  "experiment": "terminal_verifier",
  "run_name": "tv_reasoning_effort_baseline",
  "description": "NOT an RL row — the monitor set for experiments/eval_terminal_monitors_baseline.py. Six judges: {gemini-2.5-flash-lite (reasoning off) x gemini-3.5-flash-lite (effort low) x gemini-3.5-flash-lite (effort medium)} x {output-only, CoT+output}, so the 2.5-vs-3.5 and low-vs-medium comparisons are measured on THE SAME episodes with the same oracle. Policy/env settings mirror the Inkling-Small terminal runs (thinking_effort 0.5, no think_budget, max_turns 4, output_view transcript). gemini-2.5 carries no reasoning key by design — the schema rejects one. Needs OPENROUTER_API_KEY + TINKER_API_KEY.",
  "policy": "thinkingmachines/Inkling-Small",
  "backend": "tinker",
  "env": "terminal_verifier",
  "subset": "largest_island",
  "env_options": {
    "impossible": true,
    "offset_range": [4, 9],
    "max_turns": 4,
    "output_view": "transcript",
    "command_timeout": 30.0
  },
  "n_steps": 0,
  "batch_size": 16,
  "group_size": 8,
  "max_tokens": 3072,
  "think_budget": null,
  "answer_tokens": 512,
  "thinking_effort": 0.5,
  "lora_rank": 32,
  "lr": 0.0005,
  "seed": 0,
  "monitors": [
    {
      "kind": "cot", "name": "g25_out", "role": "held_out",
      "model_id": "google/gemini-2.5-flash-lite",
      "use_cot": false, "use_output": true
    },
    {
      "kind": "cot", "name": "g25_cot", "role": "held_out",
      "model_id": "google/gemini-2.5-flash-lite",
      "use_cot": true, "use_output": true
    },
    {
      "kind": "cot", "name": "g35lo_out", "role": "held_out",
      "model_id": "google/gemini-3.5-flash-lite",
      "use_cot": false, "use_output": true, "reasoning_effort": "low"
    },
    {
      "kind": "cot", "name": "g35lo_cot", "role": "held_out",
      "model_id": "google/gemini-3.5-flash-lite",
      "use_cot": true, "use_output": true, "reasoning_effort": "low"
    },
    {
      "kind": "cot", "name": "g35med_out", "role": "held_out",
      "model_id": "google/gemini-3.5-flash-lite",
      "use_cot": false, "use_output": true, "reasoning_effort": "medium"
    },
    {
      "kind": "cot", "name": "g35med_cot", "role": "held_out",
      "model_id": "google/gemini-3.5-flash-lite",
      "use_cot": true, "use_output": true, "reasoning_effort": "medium"
    }
  ]
}
